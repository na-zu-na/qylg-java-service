<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cc.qylgjavaservice.mapper.ShoppingCartMapper">

    <resultMap id="CartItemsResultMap" type="com.cc.qylgjavaservice.dto.ShoppingCartDTO.CartItems">
        <id column="sc_id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="goods_id" property="goodsId"/>
        <result column="count" property="count"/>
        <result column="p_title" property="title"/>
        <result column="p_cover" property="cover"/>
        <result column="price" property="price"/>
    </resultMap>

    <!-- 2. 定义可复用的 SQL 片段 (可选，但推荐) -->
    <sql id="Select_Cart_With_Product">
        SELECT
            sc.id AS sc_id,          -- 重命名 cart 的 id 避免与 product 的 id 冲突
            sc.user_id,
            sc.goods_id,
            sc.count,
            p.title AS p_title,      -- 重命名 title 避免歧义
            p.cover AS p_cover,       -- 重命名 cover 避免歧义
            p.price
        FROM shopping_cart sc
                 LEFT JOIN products p ON sc.goods_id = p.id
    </sql>

    <select id="selectCart" resultMap="CartItemsResultMap">
        <include refid="Select_Cart_With_Product"/>
        WHERE sc.user_id = #{currentUserId}
        ORDER BY sc.created_at DESC
    </select>
</mapper>