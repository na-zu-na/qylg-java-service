<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cc.qylgjavaservice.mapper.UserMapper">
    <resultMap id="UsersMap" type="com.cc.qylgjavaservice.entity.Users">
        <id column="id" property="id"/>
        <result column="password" property="password"/>
        <result column="role_code" property="roleCode"/>
        <result column="statusCode" property="statusCode"
                javaType="com.cc.qylgjavaservice.enums.UserStatus"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="phone" property="phone"/>
        <result column="nick_name" property="nickName"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="user_name" property="userName"/>
    </resultMap>
    <select id="selectAccountList" resultMap="UsersMap">
        select
        id,
        openid,
        password,
        role_code,
        status as statusCode,
        created_at,
        updated_at,
        phone,
        nick_name,
        avatar_url,
        user_name
        from users
        <where>
            <if test="keyword != null and keyword != ''">
                (
                user_name ilike concat('%', #{keyword}, '%')
                or nick_name ilike concat('%', #{keyword}, '%')
                or cast(id as text) = #{keyword}
                )
            </if>

            <if test="status != null">
                and status = #{status}
            </if>

            <choose>
                <when test="role_code != null">
                    and role_code = #{role_code}
                </when>
                <otherwise>
                    and role_code in (0, 1)
                </otherwise>
            </choose>
        </where>
        order by created_at desc
    </select>
</mapper>